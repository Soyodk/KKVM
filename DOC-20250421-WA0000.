		elseif CoreGUI:FindFirstChild('RobloxGui') then
			gui.Parent = CoreGUI.RobloxGui
		else
			gui.Parent = CoreGUI -- Padrão
		end
	end

	local function MakeDraggable(gui)
		local dragging = false
		local dragInput
		local dragStart
		local startPos

		local function update(input)
			if not dragging or not startPos then return end -- Checagem extra
			local delta = input.Position - dragStart
			gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end

		gui.InputBegan:Connect(function(input)
			-- Permite arrastar apenas com o botão esquerdo do mouse ou toque na barra do cabeçalho
			if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and input.Position.Y < gui.AbsolutePosition.Y + HeaderFrame.AbsoluteSize.Y then
				dragging = true
				dragStart = input.Position
				startPos = gui.Position

				local connection
				connection = input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
						startPos = nil -- Limpa a posição inicial
						if connection then connection:Disconnect() end -- Desconecta o listener para evitar memory leak
					end
				end)
			end
		end)

		gui.InputChanged:Connect(function(input)
			if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				dragInput = input
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if input == dragInput and dragging then
				update(input)
			end
		end)
	end
	MakeDraggable(MainFrame) -- Aplicar draggable ao MainFrame (arrastável pelo cabeçalho)

	-- Função de movimento suave (flutuante)
	local function bypassTP(targetCFrame)
		local player = Players.LocalPlayer
		local character = player.Character
		local hrp = character and character:FindFirstChild('HumanoidRootPart')

		if hrp then
			-- Cria e executa o Tween para mover o HumanoidRootPart
			-- Usa a tweenInfoBTP definida globalmente (com velocidade ajustada)
			local move = TweenService:Create(hrp, tweenInfoBTP, {CFrame = targetCFrame})
			move:Play()
			return move -- Retorna o tween para poder esperar por ele
		else
			warn("bypassTP: HumanoidRootPart não encontrado.")
			return nil
		end
	end

	-- Função de Farm de Moedas (Otimizada e usando Coroutine)
	local farmCoroutine = nil -- Para controlar a coroutine do farm
	function startCoinFarm()
		if farmCoroutine then
			warn("Farm já está ativo.")
			return
		end -- Já está rodando

		farmCoroutine = coroutine.create(function()
			print("Coin Farm Iniciado (Modo Flutuante Rápido)")
			while getgenv().coinFarm == true do
				local player = Players.LocalPlayer
				local character = player.Character
				local hrp = character and character:FindFirstChild('HumanoidRootPart')

				if not hrp then
					warn("Farm pausado: Personagem ou HumanoidRootPart não encontrado.")
					task.wait(2) -- Espera antes de tentar novamente
				else
					local closestCoin = nil
					local minDist = 100 -- Considera apenas moedas relativamente próximas para otimizar

					-- Procura por moedas próximas no Workspace
                    -- Usar GetPartBoundsInRadius pode ser mais eficiente se disponível/aplicável
                    -- Mas GetDescendants é mais simples de implementar aqui
					for _, item in ipairs(Workspace:GetDescendants()) do
						-- Verifica se é uma BasePart, tem o nome correto e está visível/ativa
						if item:IsA('BasePart') and item.Name == "Coin_Server" and item.Parent ~= nil and item:IsDescendantOf(Workspace) then
                            local currentDist = (hrp.Position - item.Position).Magnitude
							if currentDist < minDist then
								minDist = currentDist
								closestCoin = item
							end
						end
					end

					if closestCoin then -- Verifica se encontrou uma moeda e se ela ainda existe
						--print("Movendo para a moeda mais próxima em:", closestCoin.Position)
						local targetCFrame = CFrame.new(closestCoin.Position)

						-- Usa a função de movimento suave
						local currentTween = bypassTP(targetCFrame)

						if currentTween then
							-- Espera o tween terminar + um pequeno buffer
							currentTween.Completed:Wait()
							task.wait(0) -- Pequena espera adicional para garantir a coleta
						else
							-- Se bypassTP falhar (ex: HRP não encontrado), espera um pouco
							task.wait(0.5)
						end
					else
						--print("Nenhuma moeda próxima encontrada. Aguardando...")
						task.wait(0.5) -- Espera um pouco se não houver moedas próximas
					end
				end

				-- Verifica se deve continuar antes da próxima iteração
				if not getgenv().coinFarm then break end
				task.wait() -- Cede controle para outros scripts/processos (muito importante em loops)
			end
			print("Coin Farm Parado")
			farmCoroutine = nil -- Reseta a variável da coroutine
		end)
		coroutine.resume(farmCoroutine) -- Inicia a execução da coroutine
	end

	function stopCoinFarm()
		if farmCoroutine then
			getgenv().coinFarm = false -- Sinaliza para a coroutine parar
			-- A coroutine verificará essa flag e sairá do loop while
			print("Sinalizando parada do Coin Farm...")
			-- Não precisamos matar a coroutine, ela vai parar naturalmente
		else
			print("Farm não estava ativo.")
		end
	end

